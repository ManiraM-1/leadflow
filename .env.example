# Variables for docker-compose.yml. Every one has a default, so this file is optional:
#   cp .env.example .env   # then edit

# PostgreSQL
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow

# Host ports
API_PORT=8080
WEB_PORT=3000

# Backend
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
SEED_DATA=true

# Frontend: URL the browser uses to reach the API (baked in at image build time)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Per-app variables for running without Docker:
#   backend/.env.example, frontend/.env.example
