# All variables are optional; the defaults below are what the app uses when unset.
# Spring Boot reads them from the environment (export them, or set them in your IDE run config).

# HTTP port of the API
PORT=8080

# JDBC connection. Default: a local H2 file database in ./data (no setup needed).
# PostgreSQL example: jdbc:postgresql://localhost:5432/leadflow
DB_URL=jdbc:h2:file:./data/leadflow
DB_USERNAME=sa
DB_PASSWORD=

# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time zone used for "today" when a request doesn't send ?tz=
APP_TIMEZONE=Asia/Kolkata

# Insert 8 demo leads with discussions when the database is empty
SEED_DATA=true
